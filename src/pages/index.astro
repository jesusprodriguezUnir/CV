---
import "../styles/terminal.css";
const base = import.meta.env.BASE_URL;
const photoSrc = `${base}jesus_premium.png`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>jrodriguez ~ /cv $ — Terminal</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@300;400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="window">
      <div class="titlebar">
        <div class="dots">
          <span class="dot r"></span><span class="dot y"></span><span
            class="dot g"></span>
        </div>
        <div class="path">
          <span class="at">jrodriguez</span>@<span class="where">unir</span
          >:<span style="color:var(--accent-2)">~/cv</span> — zsh — 142×42
        </div>
        <div class="actions">
          <button class="btn" id="lang-toggle">EN</button>
          <button class="btn" id="theme-toggle">◐</button>
          <button class="btn" id="print-btn">⌘P</button>
        </div>
      </div>

      <div class="terminal">
        <pre
          class="ascii"> ┌─────────────────────────────────────────────────────────────────────────┐
 │  J E S Ú S  ·  P E D R O   R O D R Í G U E Z   C A S T R O           │
 │  >> tech lead · genai specialist · clean architecture                   │
 └─────────────────────────────────────────────────────────────────────────┘</pre>

        <div class="prompt">
          <span class="user">jrodriguez</span><span class="at">@</span><span
            class="host">unir</span
          ><span class="colon">:</span><span class="pwd">~/cv</span>
          <span class="dollar">$</span>
          <span class="cmd">whoami --verbose</span>
        </div>

        <div class="response">
          <div class="hero">
            <div>
              <h1>Jesús P. Rodríguez<span class="caret"></span></h1>
              <div class="role-strip">
                <span class="label">role:</span><span class="val" data-cv="role"
                  >Tech Lead &amp; Scrum Master</span
                >
              </div>
              <div class="summary-box" data-cv="summary"></div>
              <div class="stats" id="stats"></div>
            </div>
            <figure class="hero-photo">
              <img src={photoSrc} alt="Jesús" />
              <div class="scanlines"></div>
              <div class="badge">// online</div>
            </figure>
          </div>
        </div>

        <!-- EXPERIENCE -->
        <section id="work">
          <div class="prompt">
            <span class="user">jrodriguez</span><span class="at">@</span><span
              class="host">unir</span
            ><span class="colon">:</span><span class="pwd">~/cv</span>
            <span class="dollar">$</span>
            <span class="cmd">git log --author='jrodriguez' --since='2010'</span
            >
          </div>
          <div class="section-head">
            <h2 data-i18n="titles.work">Trayectoria</h2>
            <span class="meta">// 15+ años</span>
          </div>
          <div id="timeline"></div>
        </section>

        <!-- SKILLS -->
        <section id="skills">
          <div class="prompt">
            <span class="user">jrodriguez</span><span class="at">@</span><span
              class="host">unir</span
            ><span class="colon">:</span><span class="pwd">~/cv</span>
            <span class="dollar">$</span>
            <span class="cmd">ls ./skills | grep --color</span>
          </div>
          <div class="section-head">
            <h2 data-i18n="titles.skills">Skills</h2>
            <span class="meta" id="skill-count"></span>
          </div>
          <div class="filter-row" id="filter-row"></div>
          <div class="skill-grid" id="skill-grid"></div>
        </section>

        <!-- PROJECTS -->
        <section id="projects">
          <div class="prompt">
            <span class="user">jrodriguez</span><span class="at">@</span><span
              class="host">unir</span
            ><span class="colon">:</span><span class="pwd">~/cv</span>
            <span class="dollar">$</span>
            <span class="cmd">ls ./projects --tree</span>
          </div>
          <div class="section-head">
            <h2 data-i18n="titles.projects">Proyectos Destacados</h2>
            <span class="meta">// engineering excellence</span>
          </div>
          <div class="projects-featured">
            <div class="feat-header">
              <span class="dot"></span>
              <span class="file-name">engineering_manifesto.md</span>
            </div>
            <div class="featured-content">
              <p data-cv="projects_desc"></p>
              <div class="github-action">
                <span class="prompt-prefix">></span>
                <a
                  href="https://github.com/jesusprodriguezUnir"
                  target="_blank"
                  class="github-link"
                >
                  <span class="icon">👨‍💻</span>
                  <span class="text" data-cv="github_cta"
                    >Ver Portfolio en GitHub</span
                  >
                </a>
              </div>
            </div>
          </div>
          <div class="projects" id="projects-grid" style="display:none"></div>
        </section>


        <!-- INFO -->
        <section id="info">
          <div class="prompt">
            <span class="user">jrodriguez</span><span class="at">@</span><span
              class="host">unir</span
            ><span class="colon">:</span><span class="pwd">~/cv</span>
            <span class="dollar">$</span>
            <span class="cmd">env | grep -E 'EDU|LANG|CERT'</span>
          </div>
          <div class="info-grid" id="info-grid"></div>
        </section>

        <!-- CONTACT -->
        <section id="contact">
          <div class="prompt">
            <span class="user">jrodriguez</span><span class="at">@</span><span
              class="host">unir</span
            ><span class="colon">:</span><span class="pwd">~/cv</span>
            <span class="dollar">$</span>
            <span class="cmd">curl -X CONTACT</span>
          </div>
          <div class="section-head">
            <h2 data-i18n="titles.contact">Contacto</h2>
            <span class="meta">// 200 OK</span>
          </div>
          <div class="contact" id="contact-list"></div>
        </section>

        <footer>
          <div>$ exit · 0</div>
          <div>v2 → terminal · zsh</div>
        </footer>
      </div>
    </div>

    <script>
      import { initCV } from "../scripts/cvLogic.js";
      initCV();
    </script>
  </body>
</html>
