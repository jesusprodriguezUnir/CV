            <div class="cat">${s.category[L]}</div>
            <div class="items">${s.items.map(i => `<span>${i}</span>`).join("")}</div>
          </div>`
        ).join("");
        applyFilter();
        document.getElementById("skill-count").textContent = `// ${CV.skills.length} ${L === "es" ? "categorías" : "categories"}`;

