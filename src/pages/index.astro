---
const base = import.meta.env.BASE_URL;
const photoSrc = `${base}jesus_premium.png`;
---
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>jrodriguez ~ /cv $ — Terminal</title>
<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@300;400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
<style is:global>
  :root {
    --bg: #0a0d0c;
    --bg-2: #11161a;
    --bg-3: #161c20;
    --fg: #d8e3da;
    --fg-2: #8a9a90;
    --muted: #5a6660;
    --rule: #1f2a2e;
    --accent: #4ade80;
    --accent-2: #f59e0b;
    --accent-3: #38bdf8;
    --danger: #f87171;
    --mono: "IBM Plex Mono", ui-monospace, Menlo, monospace;
    --sans: "IBM Plex Sans", -apple-system, system-ui, sans-serif;
  }
  [data-theme="light"] {
    --bg: #f3f1ec;
    --bg-2: #e8e6df;
    --bg-3: #ddd9cf;
    --fg: #161816;
    --fg-2: #3e4540;
    --muted: #6b736d;
    --rule: #cfcbc1;
    --accent: #16a34a;
    --accent-2: #b45309;
    --accent-3: #0369a1;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    font-family: var(--mono);
    background: var(--bg);
    color: var(--fg);
    font-size: 14px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    background-image:
      linear-gradient(var(--rule) 1px, transparent 1px),
      linear-gradient(90deg, var(--rule) 1px, transparent 1px);
    background-size: 32px 32px;
    background-position: -1px -1px;
    transition: background-color .25s;
  }
  a { color: inherit; text-decoration: none; }
  ::selection { background: var(--accent); color: var(--bg); }

  /* WINDOW CHROME */
  .window {
    max-width: 1200px;
    margin: 28px auto;
    background: var(--bg-2);
    border: 1px solid var(--rule);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 30px 60px -20px rgba(0,0,0,.5);
  }
  .titlebar {
    display: flex; align-items: center; gap: 12px;
    padding: 10px 14px;
    background: var(--bg-3);
    border-bottom: 1px solid var(--rule);
    position: sticky; top: 0; z-index: 30;
  }
  .dots { display: flex; gap: 6px; }
  .dot { width: 12px; height: 12px; border-radius: 50%; }
  .dot.r { background: #ff5f56; }
  .dot.y { background: #ffbd2e; }
  .dot.g { background: #27c93f; }
  .titlebar .path {
    flex: 1;
    text-align: center;
    color: var(--fg-2);
    font-size: 12px;
    letter-spacing: .04em;
  }
  .titlebar .path .at { color: var(--accent); }
  .titlebar .path .where { color: var(--accent-3); }
  .actions { display: flex; gap: 6px; }
  .btn {
    background: transparent;
    color: var(--fg-2);
    border: 1px solid var(--rule);
    padding: 4px 10px;
    border-radius: 4px;
    font-family: var(--mono);
    font-size: 11px;
    cursor: pointer;
    letter-spacing: .04em;
    transition: all .15s;
  }
  .btn:hover { border-color: var(--accent); color: var(--accent); }

  .terminal { padding: 32px 40px 60px; }

  /* PROMPT / HEADERS */
  .prompt {
    font-size: 13px;
    color: var(--fg-2);
    margin-bottom: 8px;
    letter-spacing: .02em;
  }
  .prompt .user { color: var(--accent); }
  .prompt .at { color: var(--muted); }
  .prompt .host { color: var(--accent-3); }
  .prompt .colon { color: var(--muted); }
  .prompt .pwd { color: var(--accent-2); }
  .prompt .dollar { color: var(--fg); margin-right: 6px; }
  .prompt .cmd { color: var(--fg); }

  .response { margin-bottom: 36px; }

  .ascii {
    color: var(--accent);
    font-size: 11px;
    line-height: 1.1;
    white-space: pre;
    margin-bottom: 18px;
    overflow-x: auto;
  }

  /* HERO */
  .hero {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 36px;
    align-items: start;
    margin-bottom: 30px;
  }
  .hero h1 {
    font-family: var(--mono);
    font-weight: 600;
    font-size: clamp(36px, 5vw, 56px);
    line-height: 1.05;
    letter-spacing: -.02em;
    margin-bottom: 14px;
  }
  .hero h1 .caret {
    display: inline-block;
    background: var(--accent);
    width: .55em; height: 1em;
    margin-left: 6px;
    transform: translateY(.1em);
    animation: blink 1.1s steps(2) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }
  .role-strip {
    display: inline-block;
    background: var(--bg-3);
    border: 1px solid var(--rule);
    border-left: 3px solid var(--accent);
    padding: 6px 14px;
    font-size: 13px;
    margin-bottom: 18px;
  }
  .role-strip .label { color: var(--muted); }
  .role-strip .val { color: var(--accent); margin-left: 8px; }

  .summary-box {
    border: 1px dashed var(--rule);
    background: var(--bg);
    padding: 18px 20px;
    font-family: var(--sans);
    font-size: 15px;
    line-height: 1.55;
    color: var(--fg-2);
    border-radius: 4px;
  }
  .summary-box::before {
    content: "// ";
    color: var(--muted);
  }

  .hero-photo {
    position: relative;
    aspect-ratio: 1 / 1.1;
    border: 1px solid var(--rule);
    background: var(--bg-3);
    overflow: hidden;
  }
  .hero-photo img {
    width: 100%; height: 100%;
    object-fit: cover;
    filter: saturate(1.1) contrast(1.05);
    transition: filter 0.3s ease;
  }
  .hero-photo:hover img {
    filter: saturate(1.2) contrast(1.1);
  }
  .hero-photo::after {
    content: "";
    position: absolute; inset: 0;
    background: linear-gradient(180deg, transparent 70%, var(--bg-3) 100%);
    pointer-events: none;
  }
  .hero-photo .scanlines {
    position: absolute; inset: 0;
    background: repeating-linear-gradient(0deg, rgba(0,0,0,.18) 0 1px, transparent 1px 3px);
    pointer-events: none;
    opacity: .6;
  }
  .hero-photo .badge {
    position: absolute; left: 10px; bottom: 10px;
    font-size: 10px; color: var(--accent);
    letter-spacing: .15em;
    text-transform: uppercase;
    background: rgba(0,0,0,.5);
    padding: 4px 8px;
    border: 1px solid var(--accent);
    border-radius: 2px;
  }

  /* STATS ROW */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin: 20px 0 10px;
  }
  .stat {
    border: 1px solid var(--rule);
    background: var(--bg);
    padding: 14px 16px;
    border-radius: 6px;
  }
  .stat .v {
    font-family: var(--mono);
    font-weight: 600;
    font-size: 26px;
    color: var(--accent);
    line-height: 1;
    margin-bottom: 6px;
  }
  .stat .k {
    font-size: 11px;
    color: var(--fg-2);
    letter-spacing: .02em;
  }

  /* SECTIONS */
  section { margin-top: 50px; }
  .section-head {
    display: flex; align-items: baseline; gap: 12px;
    margin-bottom: 18px;
    border-bottom: 1px dashed var(--rule);
    padding-bottom: 10px;
  }
  .section-head h2 {
    font-family: var(--mono);
    font-size: 20px;
    font-weight: 600;
    color: var(--fg);
  }
  .section-head h2::before { content: "## "; color: var(--accent); }
  .section-head .meta { color: var(--muted); font-size: 12px; }

  /* EXPERIENCE */
  .job {
    background: var(--bg);
    border: 1px solid var(--rule);
    border-radius: 6px;
    margin-bottom: 14px;
    overflow: hidden;
  }
  .job-bar {
    display: flex; justify-content: space-between; align-items: center;
    padding: 8px 14px;
    background: var(--bg-3);
    border-bottom: 1px solid var(--rule);
    font-size: 12px;
    color: var(--fg-2);
  }
  .job-bar .name { color: var(--accent); }
  .job-body { padding: 18px 22px; font-family: var(--sans); }
  .job-body h3 {
    font-family: var(--mono);
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 4px;
  }
  .job-body .co {
    color: var(--accent-3);
    font-family: var(--mono);
    font-size: 13px;
    margin-bottom: 4px;
  }
  .job-body .when {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 12px;
    margin-bottom: 14px;
  }
  .job-body ul { list-style: none; padding: 0; margin-bottom: 12px; }
  .job-body li {
    padding-left: 22px;
    position: relative;
    margin-bottom: 6px;
    color: var(--fg-2);
    font-size: 14px;
  }
  .job-body li::before {
    content: "▸";
    position: absolute; left: 0;
    color: var(--accent);
  }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
  .tag {
    font-family: var(--mono);
    font-size: 11px;
    background: var(--bg-3);
    color: var(--accent);
    border: 1px solid var(--rule);
    padding: 3px 9px;
    border-radius: 3px;
  }
  .tag::before { content: "#"; opacity: .5; margin-right: 2px; }

  /* SKILLS */
  .filter-row {
    display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px;
  }
  .chip {
    background: var(--bg-3);
    border: 1px solid var(--rule);
    color: var(--fg-2);
    padding: 5px 12px;
    border-radius: 4px;
    font-size: 12px;
    font-family: var(--mono);
    cursor: pointer;
    transition: all .15s;
  }
  .chip:hover { color: var(--accent); border-color: var(--accent); }
  .chip.active { background: var(--accent); color: var(--bg); border-color: var(--accent); }

  .skill-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  .skill-card {
    background: var(--bg);
    border: 1px solid var(--rule);
    border-radius: 6px;
    padding: 16px 18px;
    transition: opacity .25s, transform .15s;
  }
  .skill-card.is-hidden { display: none; }
  .skill-card .cat {
    display: flex; align-items: center; gap: 8px;
    color: var(--accent-2);
    font-size: 12px;
    letter-spacing: .08em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .skill-card .cat::before {
    content: "▶"; color: var(--accent); font-size: 10px;
  }
  .skill-card .items {
    display: flex; flex-wrap: wrap; gap: 6px;
  }
  .skill-card .items span {
    background: var(--bg-3);
    border: 1px solid var(--rule);
    padding: 3px 9px;
    border-radius: 3px;
    font-size: 12px;
  }

  /* PROJECTS */
  .projects {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }
  .project {
    background: var(--bg);
    border: 1px solid var(--rule);
    border-radius: 6px;
    padding: 18px 20px;
    transition: border-color .15s, transform .15s;
    position: relative;
    display: flex; flex-direction: column;
  }
  .project:hover { border-color: var(--accent); transform: translateY(-2px); }
  .project .head {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 8px;
    font-size: 11px;
    color: var(--muted);
  }
  .project .kind {
    color: var(--accent);
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .project .arrow { color: var(--fg-2); }
  .project h4 {
    font-family: var(--mono);
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 8px;
  }
  .project p {
    font-family: var(--sans);
    color: var(--fg-2);
    font-size: 14px;
    line-height: 1.5;
    margin-bottom: 14px;
    flex: 1;
  }

  /* TESTIMONIALS */
  .quotes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .quote {
    background: var(--bg);
    border: 1px solid var(--rule);
    border-radius: 6px;
    padding: 18px 20px;
    border-left: 3px solid var(--accent);
  }
  .quote::before {
    content: "$ echo";
    display: block;
    font-size: 11px;
    color: var(--muted);
    margin-bottom: 10px;
  }
  .quote blockquote {
    font-family: var(--sans);
    font-size: 14px;
    line-height: 1.55;
    color: var(--fg);
    margin-bottom: 12px;
  }
  .quote cite {
    font-style: normal;
    font-size: 11px;
    color: var(--fg-2);
    display: flex; flex-direction: column;
    gap: 2px;
  }
  .quote cite strong { color: var(--accent); }

  /* CONTACT */
  .contact {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-top: 14px;
  }
  .contact-row {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 16px;
    background: var(--bg);
    border: 1px solid var(--rule);
    border-radius: 6px;
    transition: all .15s;
  }
  .contact-row:hover { border-color: var(--accent); transform: translateX(2px); }
  .contact-row .key {
    color: var(--accent);
    font-size: 12px;
    min-width: 90px;
  }
  .contact-row .val {
    color: var(--fg);
    font-size: 13px;
    word-break: break-all;
  }

  /* INFO GRID */
  .info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 14px;
    margin-top: 14px;
  }
  .info-card {
    background: var(--bg);
    border: 1px solid var(--rule);
    border-radius: 6px;
    padding: 16px;
  }
  .info-card h4 {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--accent-2);
    letter-spacing: .08em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .info-card .item {
    display: flex; justify-content: space-between; align-items: baseline;
    padding: 5px 0;
    font-size: 13px;
    border-bottom: 1px dashed var(--rule);
  }
  .info-card .item:last-child { border-bottom: 0; }
  .info-card .item .lvl { color: var(--accent); font-size: 11px; }
  .info-card .lang-dots {
    display: inline-flex; gap: 3px;
    margin-left: 6px;
  }
  .info-card .lang-dots b {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--accent);
    display: inline-block;
  }
  .info-card .lang-dots b.off { background: var(--rule); }
  .info-card .cert {
    font-size: 12px;
    color: var(--fg-2);
    padding: 6px 0;
    border-bottom: 1px dashed var(--rule);
  }
  .info-card .cert:last-child { border-bottom: 0; }
  .info-card .cert::before {
    content: "✓ "; color: var(--accent);
  }

  /* PHILOSOPHY */
  .philo {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-top: 16px;
  }
  .philo .card {
    background: var(--bg);
    border: 1px solid var(--rule);
    border-radius: 6px;
    padding: 14px 16px;
  }
  .philo .card .k {
    font-size: 11px;
    color: var(--accent-2);
    letter-spacing: .12em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .philo .card .v {
    font-family: var(--sans);
    font-size: 15px;
    line-height: 1.4;
    color: var(--fg);
  }

  footer {
    margin-top: 40px;
    padding-top: 18px;
    border-top: 1px dashed var(--rule);
    display: flex; justify-content: space-between;
    color: var(--muted);
    font-size: 12px;
  }

  @media (max-width: 880px) {
    .terminal { padding: 18px 16px 40px; }
    .hero { grid-template-columns: 1fr; }
    .hero-photo { max-width: 240px; }
    .stats, .skill-grid, .projects, .quotes, .contact, .info-grid, .philo {
      grid-template-columns: 1fr;
    }
  }

  @page { size: A4; margin: 12mm; }
  @media print {
    :root {
      --bg: #fff; --bg-2: #fff; --bg-3: #f4f4f1;
      --fg: #111; --fg-2: #333; --muted: #888; --rule: #d0d0d0;
      --accent: #1f7a3a; --accent-2: #8a5a00; --accent-3: #1e5fa6;
    }
    body { background: #fff !important; background-image: none; font-size: 9.5pt; }
    .titlebar, .actions, footer, .filter-row { display: none !important; }
    .window { box-shadow: none; border: 0; margin: 0; max-width: 100%; border-radius: 0; }
    .terminal { padding: 0; }
    .hero { grid-template-columns: 1fr 110px; gap: 18px; margin-bottom: 14px; }
    .hero h1 { font-size: 22pt; line-height: 1.05; }
    .hero h1 .caret { display: none; }
    .hero-photo { aspect-ratio: 1; max-width: 110px; max-height: 110px; }
    .summary-box { font-size: 9.5pt; padding: 8px 10px; }
    .stats { gap: 6px; }
    .stat { padding: 6px 8px; }
    .stat .v { font-size: 14pt; }
    .stat .k { font-size: 8pt; }
    section { margin-top: 14px; page-break-inside: avoid; }
    .section-head { padding-bottom: 4px; margin-bottom: 8px; }
    .section-head h2 { font-size: 12pt; }
    .job { margin-bottom: 6px; break-inside: avoid; }
    .job-bar { padding: 4px 10px; }
    .job-body { padding: 8px 12px; }
    .job-body h3 { font-size: 11pt; }
    .skill-grid, .projects { grid-template-columns: repeat(2, 1fr); gap: 6px; }
    .skill-card, .project { padding: 8px 10px; min-height: 0; break-inside: avoid; }
    .quotes { grid-template-columns: repeat(3, 1fr); gap: 6px; }
    .quote { padding: 8px 10px; }
    .quote blockquote { font-size: 9pt; }
    .info-grid { grid-template-columns: repeat(3, 1fr); gap: 6px; }
    .philo { grid-template-columns: repeat(4, 1fr); gap: 6px; }
    .contact { grid-template-columns: repeat(2, 1fr); gap: 6px; }
    .contact-row { padding: 6px 10px; }
    .ascii { display: none; }
    .hero-photo::after, .hero-photo .scanlines { display: none; }
    .hero-photo img { filter: grayscale(1); }
  }
</style>
</head>
<body>
  <div class="window">
    <div class="titlebar">
      <div class="dots"><span class="dot r"></span><span class="dot y"></span><span class="dot g"></span></div>
      <div class="path"><span class="at">jrodriguez</span>@<span class="where">unir</span>:<span style="color:var(--accent-2)">~/cv</span> — zsh — 142×42</div>
      <div class="actions">
        <button class="btn" id="lang-toggle">EN</button>
        <button class="btn" id="theme-toggle">◐</button>
        <button class="btn" id="print-btn">⌘P</button>
      </div>
    </div>

    <div class="terminal">
      <pre class="ascii"> ┌─────────────────────────────────────────────────────────────────────────┐
 │  J E S Ú S  ·  P E D R O   R O D R Í G U E Z   C A S T R O           │
 │  >> tech lead · scrum master · clean architecture · .NET · angular      │
 └─────────────────────────────────────────────────────────────────────────┘</pre>

      <div class="prompt"><span class="user">jrodriguez</span><span class="at">@</span><span class="host">unir</span><span class="colon">:</span><span class="pwd">~/cv</span> <span class="dollar">$</span> <span class="cmd">whoami --verbose</span></div>

      <div class="response">
        <div class="hero">
          <div>
            <h1>Jesús P. Rodríguez<span class="caret"></span></h1>
            <div class="role-strip">
              <span class="label">role:</span><span class="val" data-cv="role">Tech Lead &amp; Scrum Master</span>
            </div>
            <div class="summary-box" data-cv="summary"></div>
            <div class="stats" id="stats"></div>
          </div>
          <figure class="hero-photo">
            <img src={photoSrc} alt="Jesús" />
            <div class="scanlines"></div>
            <div class="badge">// online</div>
          </figure>
        </div>
      </div>

      <!-- ABOUT / PHILOSOPHY -->
      <section id="about">
        <div class="prompt"><span class="user">jrodriguez</span><span class="at">@</span><span class="host">unir</span><span class="colon">:</span><span class="pwd">~/cv</span> <span class="dollar">$</span> <span class="cmd">cat philosophy.md</span></div>
        <div class="section-head">
          <h2 data-i18n="titles.philosophy">Cómo trabajo</h2>
          <span class="meta">// 4 principios</span>
        </div>
        <div class="philo" id="philo"></div>
      </section>

      <!-- EXPERIENCE -->
      <section id="work">
        <div class="prompt"><span class="user">jrodriguez</span><span class="at">@</span><span class="host">unir</span><span class="colon">:</span><span class="pwd">~/cv</span> <span class="dollar">$</span> <span class="cmd">git log --author='jrodriguez' --since='2010'</span></div>
        <div class="section-head">
          <h2 data-i18n="titles.work">Trayectoria</h2>
          <span class="meta">// 15+ años</span>
        </div>
        <div id="timeline"></div>
      </section>

      <!-- SKILLS -->
      <section id="skills">
